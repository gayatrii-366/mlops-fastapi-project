# ─── App ─────────────────────────────────────────────────
API_KEY=supersecret123

# ─── AWS CloudWatch Logging ───────────────────────────────
# Set ENABLE_CLOUDWATCH=true to send logs to AWS CloudWatch
ENABLE_CLOUDWATCH=false

# Your AWS region (e.g. us-east-1, ap-south-1)
AWS_REGION=us-east-1

# CloudWatch log group and stream names
CW_LOG_GROUP=/mlops/iris-api
CW_LOG_STREAM=app-logs

# AWS credentials — leave blank if using IAM role / AWS CLI profile
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=